include LICENSE
include THIRD_PARTY_NOTICES.txt
include requirements-dev.lock
include rust/Cargo.toml rust/Cargo.lock native/Cargo.toml native/Cargo.lock
recursive-include rust/src *.rs *.json
recursive-include native/src *.rs
recursive-include catalog *.json
recursive-include rust/examples *.rs
recursive-include fixtures *.json *.jsonl
recursive-include tools *.py *.sh
recursive-include examples *.py
recursive-include docs *.md
recursive-include schemas *.json *.md
exclude python/workbook_forge/*.so
exclude python/workbook_forge/*.dylib
