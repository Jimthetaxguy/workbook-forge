{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Review finding",
  "description": "One defect claim from an adversarial review. There is no field for praise: a finding states what is wrong and how to see it.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "lens", "base", "severity", "claim", "expectation", "location", "evidence", "attacks_attempted", "status", "contexts"],
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z-]+-[0-9]{2}$"},
    "lens": {"enum": ["contract", "parity", "silent-failure", "oracle", "boundary", "evidence", "simplification"]},
    "base": {"enum": ["main", "pr5"], "description": "main: the defect exists on the main branch. pr5: it exists only with the open pull request applied."},
    "severity": {"enum": ["critical", "high", "medium", "low"]},
    "claim": {"type": "string", "minLength": 20, "maxLength": 600},
    "expectation": {"type": "string", "minLength": 1, "description": "The line of the reviewer's stage 1 expectations this finding tests, or the word unanticipated."},
    "location": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file", "line_start", "line_end"],
      "properties": {
        "file": {"type": "string", "minLength": 1},
        "line_start": {"type": "integer", "minimum": 1},
        "line_end": {"type": "integer", "minimum": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command", "output"],
      "properties": {
        "command": {"type": "string", "minLength": 1},
        "output": {"type": "string", "minLength": 1},
        "exit_code": {"type": ["integer", "null"]}
      }
    },
    "attacks_attempted": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 5}},
    "status": {"enum": ["OPEN", "PLAUSIBLE", "CONFIRMED", "REFUTED", "STALE"]},
    "contexts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["finder"],
      "properties": {
        "finder": {"type": "string", "minLength": 1},
        "refuter": {"type": "string"},
        "fixer": {"type": "string"},
        "verifier": {"type": "string"}
      }
    },
    "refutation": {"type": "string"},
    "root_reproduction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command", "exit_code", "output", "tip"],
      "properties": {
        "command": {"type": "string"},
        "exit_code": {"type": ["integer", "null"]},
        "output": {"type": "string"},
        "tip": {"type": "string", "pattern": "^[0-9a-f]{7,40}$"}
      }
    },
    "attestation": {"type": "string", "pattern": "^[0-9a-f]{64}$", "description": "SHA-256 of the instruction files the reviewer's harness loaded. The content is never stored."},
    "planted": {"type": "boolean", "description": "Set by the coordinator when the finding matches a planted defect."},
    "fix_commit": {"type": "string", "pattern": "^[0-9a-f]{7,40}$"}
  }
}
