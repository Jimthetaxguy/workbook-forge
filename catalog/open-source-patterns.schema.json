{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://workbook-forge.local/catalog/open-source-patterns.schema.json",
  "title": "Workbook Forge permitted open-source implementation patterns",
  "type": "object",
  "required": ["catalog_version", "catalog_schema", "retrieved", "eligibility_policy", "sources", "patterns"],
  "properties": {
    "catalog_version": {"type": "string", "minLength": 1},
    "catalog_schema": {"const": "open-source-patterns.schema.json"},
    "retrieved": {"type": "string", "format": "date"},
    "eligibility_policy": {
      "type": "object",
      "required": ["allowed_licenses", "code_copied", "rule"],
      "properties": {
        "allowed_licenses": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/permissiveLicense"}},
        "code_copied": {"const": false},
        "rule": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "repository", "license_evidence_url", "licenses", "reference_urls", "scope_note"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "name": {"type": "string", "minLength": 1},
          "repository": {"type": "string", "format": "uri"},
          "license_evidence_url": {"type": "string", "format": "uri"},
          "licenses": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/permissiveLicense"}},
          "reference_urls": {"type": "array", "minItems": 1, "items": {"type": "string", "format": "uri"}},
          "scope_note": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    },
    "patterns": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "source_refs", "observation", "workbook_forge_decision", "next_application", "code_copied"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "source_refs": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "observation": {"type": "string", "minLength": 1},
          "workbook_forge_decision": {"type": "string", "minLength": 1},
          "next_application": {"type": "string", "minLength": 1},
          "code_copied": {"const": false}
        },
        "additionalProperties": false
      }
    }
  },
  "$defs": {
    "permissiveLicense": {
      "description": "Permissive SPDX license with no copyleft terms.",
      "enum": ["0BSD", "Apache-2.0", "BSD-2-Clause", "BSD-3-Clause", "BSL-1.0", "CC0-1.0", "ISC", "MIT", "MIT-0", "PSF-2.0", "Unicode-3.0", "Unicode-DFS-2016", "Unlicense", "Zlib"]
    }
  },
  "additionalProperties": false
}
