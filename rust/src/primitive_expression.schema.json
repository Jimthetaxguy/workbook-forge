{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://workbook-forge.dev/schemas/primitive-expression.schema.json",
  "title": "Workbook Forge canonical native primitive expression",
  "description": "Canonical serialization uses uppercase function names. Runtime validation additionally enforces finite numbers, rectangular matrices, UTF-16 text length, call arity, omission placement, total nodes/depth/value elements, and byte limits. Input decoders accept ASCII function-name case variants and normalize them.",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1,
      "type": "integer"
    },
    "expression": {
      "$ref": "#/$defs/node"
    }
  },
  "required": [
    "schema_version",
    "expression"
  ],
  "additionalProperties": false,
  "$defs": {
    "scalar": {
      "oneOf": [
        {
          "type": "number"
        },
        {
          "type": "string",
          "maxLength": 32767
        },
        {
          "type": "boolean"
        },
        {
          "type": "null"
        },
        {
          "type": "object",
          "properties": {
            "error": {
              "enum": [
                "#VALUE!",
                "#DIV/0!",
                "#REF!",
                "#NAME?",
                "#NUM!",
                "#N/A",
                "#CALC!"
              ]
            }
          },
          "required": [
            "error"
          ],
          "additionalProperties": false
        }
      ]
    },
    "value": {
      "oneOf": [
        {
          "$ref": "#/$defs/scalar"
        },
        {
          "type": "object",
          "properties": {
            "range": {
              "type": "array",
              "minItems": 1,
              "maxItems": 100000,
              "items": {
                "type": "array",
                "minItems": 1,
                "maxItems": 100000,
                "items": {
                  "$ref": "#/$defs/scalar"
                }
              }
            }
          },
          "required": [
            "range"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "array": {
              "type": "array",
              "minItems": 1,
              "maxItems": 100000,
              "items": {
                "type": "array",
                "minItems": 1,
                "maxItems": 100000,
                "items": {
                  "$ref": "#/$defs/scalar"
                }
              }
            }
          },
          "required": [
            "array"
          ],
          "additionalProperties": false
        }
      ]
    },
    "node": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "literal"
            },
            "value": {
              "$ref": "#/$defs/value"
            }
          },
          "required": [
            "kind",
            "value"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "input"
            },
            "name": {
              "type": "string",
              "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,63}$"
            }
          },
          "required": [
            "kind",
            "name"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "call"
            },
            "function": {
              "enum": [
                "SUM",
                "AVERAGE",
                "MIN",
                "MAX",
                "COUNT",
                "IF",
                "IFERROR",
                "ROUND",
                "ABS"
              ]
            },
            "arguments": {
              "type": "array",
              "maxItems": 255,
              "items": {
                "$ref": "#/$defs/node"
              }
            }
          },
          "required": [
            "kind",
            "function",
            "arguments"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "binary"
            },
            "operator": {
              "enum": [
                "+",
                "-",
                "*",
                "/",
                "=",
                "<>",
                "<",
                "<=",
                ">",
                ">="
              ]
            },
            "left": {
              "$ref": "#/$defs/node"
            },
            "right": {
              "$ref": "#/$defs/node"
            }
          },
          "required": [
            "kind",
            "operator",
            "left",
            "right"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "omitted"
            }
          },
          "required": [
            "kind"
          ],
          "additionalProperties": false
        }
      ]
    }
  }
}
