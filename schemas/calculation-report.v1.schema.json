{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://workbook-forge.dev/schemas/calculation-report.v1.schema.json",
  "title": "Workbook Forge calculation report v1",
  "description": "Fresh formula results for one canonical workbook. This is not a second workbook model. An imported cell cache stays on Cell.value; origin calculated belongs to Formula.result.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "report_version",
    "stage",
    "engine",
    "behavior_profile",
    "schema_version",
    "model_version",
    "inputs",
    "outputs",
    "diagnostics",
    "calculated_formulas",
    "unresolved_formulas"
  ],
  "properties": {
    "report_version": {"const": 1},
    "stage": {"const": "calculate"},
    "engine": {"enum": ["python", "rust"]},
    "behavior_profile": {"const": "workbook-forge"},
    "schema_version": {"const": 1},
    "model_version": {"const": 1},
    "source_fingerprint": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "inputs": {"type": "array", "items": {"$ref": "#/$defs/input"}},
    "outputs": {"type": "array", "items": {"$ref": "#/$defs/output"}},
    "diagnostics": {"type": "array", "items": {"$ref": "#/$defs/diagnostic"}},
    "calculated_formulas": {"type": "integer", "minimum": 0},
    "unresolved_formulas": {"type": "integer", "minimum": 0}
  },
  "$defs": {
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "sheet", "address", "origin", "value"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "sheet": {"type": "string", "minLength": 1},
        "address": {"type": "string", "pattern": "^[A-Z]{1,3}[1-9][0-9]{0,6}$"},
        "origin": {"enum": ["authored", "imported", "calculated", null]},
        "value": {"$ref": "#/$defs/value"}
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "sheet", "address", "origin", "result"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "sheet": {"type": "string", "minLength": 1},
        "address": {"type": "string", "pattern": "^[A-Z]{1,3}[1-9][0-9]{0,6}$"},
        "origin": {"enum": ["calculated", "not_calculated", "authored", "imported", null]},
        "result": {"$ref": "#/$defs/value"}
      }
    },
    "diagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "classification", "message"],
      "properties": {
        "code": {
          "enum": [
            "unsupported_formula",
            "parse_error",
            "cycle",
            "resource_limit",
            "invalid_reference",
            "blocked_dependency"
          ]
        },
        "classification": {
          "enum": ["unsupported", "parse_error", "cycle", "resource_limit", "invalid_reference"]
        },
        "message": {"type": "string"},
        "sheet": {"type": "string"},
        "address": {"type": "string", "pattern": "^[A-Z]{1,3}[1-9][0-9]{0,6}$"},
        "function": {"type": "string"}
      }
    },
    "value": {
      "oneOf": [
        {"type": "null"},
        {"type": "number"},
        {"type": "string"},
        {"type": "boolean"},
        {"$ref": "#/$defs/error"}
      ]
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["error", "message"],
      "properties": {
        "error": {
          "enum": [
            "#NULL!",
            "#DIV/0!",
            "#VALUE!",
            "#REF!",
            "#NAME?",
            "#NUM!",
            "#N/A",
            "#SPILL!",
            "#CALC!"
          ]
        },
        "message": {"type": ["string", "null"]}
      }
    }
  }
}
